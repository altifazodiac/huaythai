# Essential npmrc configuration for Tailwind CSS v4 + lightningcss on Vercel
# Ensure optional dependencies (like lightningcss native binaries) are installed
engine-strict=false
save-exact=false
update-notifier=false

# Auto install peer dependencies
auto-install-peers=true

# Use legacy peer deps to avoid conflicts  
legacy-peer-deps=true

# Don't skip optional dependencies (needed for native binaries)
optional=true
